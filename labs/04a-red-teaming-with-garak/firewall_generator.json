{
  "rest": {
    "RestGenerator": {
      "name": "semantic_firewall_local",
      "uri": "http://localhost:8000/chat",
      "method": "post",
      "headers": {
        "Content-Type": "application/json"
      },
      "req_template_json_object": {
        "message": "$INPUT"
      },
      "response_json": true,
      "response_json_field": "response",
      "request_timeout": 90
    }
  }
}
